{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cvkorvex.vercel.app"
        }
      ],
      "destination": "https://vmkorvex.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/painel",
      "destination": "/painel.html"
    }
  ]
}
